# Which provider to try first: mistral | gemini | openrouter
# The app automatically falls back to the others if this one fails.
LLM_PROVIDER=mistral

# At least one API key is required.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
